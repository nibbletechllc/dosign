#. module: dosign
#: model:mail.template,body_html:dosign.mail_template_dosign_expired
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,sans-serif;color:#1a1a1a;\">\n"
"                    <p>\n"
"                        <strong t-out=\"object.name or ''\"/> expired before all signatures\n"
"                        were collected.\n"
"                    </p>\n"
"                    <p>You can resend it (\"Send again\") to restart the signing process.</p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: dosign
#: model:mail.template,body_html:dosign.mail_template_dosign_completed
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,sans-serif;color:#1a1a1a;\">\n"
"                    <p>\n"
"                        <strong t-out=\"object.name or ''\"/> has been signed by all parties.\n"
"                    </p>\n"
"                    <p style=\"color:#888;font-size:13px;\">\n"
"                        Reference: <t t-out=\"object.reference or ''\"/>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: dosign
#: model:mail.template,body_html:dosign.mail_template_dosign_cert_alert
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,sans-serif;color:#1a1a1a;\">\n"
"                    <p>\n"
"                        The signing certificate <strong t-out=\"object.name or ''\"/> is\n"
"                        <t t-out=\"object.state == 'expired' and 'expired' or 'expiring soon'\"/>.\n"
"                    </p>\n"
"                    <p t-if=\"object.valid_to\" style=\"color:#888;font-size:13px;\">\n"
"                        Valid until <t t-out=\"object.valid_to\" t-options=\"{&quot;widget&quot;: &quot;date&quot;}\"/>.\n"
"                        Upload a replacement under Dosign &gt; Configuration &gt; Certificates.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: dosign
#: model:mail.template,body_html:dosign.mail_template_dosign_request
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,sans-serif;color:#1a1a1a;\">\n"
"                    <p>Hello <t t-out=\"object.name or ''\"/>,</p>\n"
"                    <p>\n"
"                        <t t-out=\"object.document_id.user_id.name or 'A colleague'\"/>\n"
"                        has requested your signature on\n"
"                        <strong t-out=\"object.document_id.name or ''\"/>.\n"
"                    </p>\n"
"                    <p t-if=\"object.document_id.message\">\n"
"                        <em t-out=\"object.document_id.message\"/>\n"
"                    </p>\n"
"                    <p style=\"margin:24px 0;\">\n"
"                        <a t-att-href=\"object._portal_sign_url()\" style=\"background:#714B67;color:#fff;padding:10px 22px;border-radius:6px;text-decoration:none;display:inline-block;\">\n"
"                            Review &amp; Sign\n"
"                        </a>\n"
"                    </p>\n"
"                    <p t-if=\"object.document_id.expiry_date\" style=\"color:#888;font-size:13px;\">\n"
"                        Please sign before\n"
"                        <t t-out=\"object.document_id.expiry_date\" t-options=\"{&quot;widget&quot;: &quot;date&quot;}\"/>.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: dosign
#: model:mail.template,body_html:dosign.mail_template_dosign_reminder
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,sans-serif;color:#1a1a1a;\">\n"
"                    <p>Hello <t t-out=\"object.name or ''\"/>,</p>\n"
"                    <p>\n"
"                        This is a friendly reminder to sign\n"
"                        <strong t-out=\"object.document_id.name or ''\"/>.\n"
"                    </p>\n"
"                    <p style=\"margin:24px 0;\">\n"
"                        <a t-att-href=\"object._portal_sign_url()\" style=\"background:#714B67;color:#fff;padding:10px 22px;border-radius:6px;text-decoration:none;display:inline-block;\">\n"
"                            Review &amp; Sign\n"
"                        </a>\n"
"                    </p>\n"
"                    <p t-if=\"object.document_id.expiry_date\" style=\"color:#888;font-size:13px;\">\n"
"                        Expires on\n"
"                        <t t-out=\"object.document_id.expiry_date\" t-options=\"{&quot;widget&quot;: &quot;date&quot;}\"/>.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: dosign
#: model:mail.template,body_html:dosign.mail_template_dosign_declined
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,sans-serif;color:#1a1a1a;\">\n"
"                    <t t-set=\"declined\" t-value=\"object.signer_ids.filtered(lambda s: s.state == 'declined')[:1]\"/>\n"
"                    <p>\n"
"                        <strong t-out=\"declined.name or 'A signer'\"/> declined to sign\n"
"                        <strong t-out=\"object.name or ''\"/>.\n"
"                    </p>\n"
"                    <p t-if=\"declined.decline_reason\">\n"
"                        Reason: <em t-out=\"declined.decline_reason\"/>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

