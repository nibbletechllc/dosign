<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Card on /my with the number of signature documents of the contact. -->
    <template id="portal_my_home_dosign" name="Signature Documents"
              inherit_id="portal.portal_my_home" customize_show="True" priority="45">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <!-- Same markup as portal.portal_docs_entry, except that the number of
             documents is always displayed (Odoo 19 only uses the counter to
             hide empty cards). The card stays hidden until /my/counters returns
             a count greater than zero. -->
        <div id="portal_client_category" position="inside">
            <div class="o_portal_index_card d-none col-md-6 order-2">
                <a href="/my/dosign" title="Signature Documents"
                   class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                    <div class="o_portal_icon d-block align-self-start">
                        <img src="/dosign/static/src/img/portal-sign.svg" alt=""/>
                    </div>
                    <div>
                        <div class="mt-0 mb-1 fs-5 fw-normal lh-1 d-flex gap-2">
                            <span class="fw-bold" data-placeholder_count="dosign_document_count"/>
                            <!-- A div (not a span): adjacent inline nodes would be
                                 merged with the counter into one translation term. -->
                            <div>Signature Documents</div>
                        </div>
                        <div class="opacity-75">Sign pending documents and download signed ones</div>
                    </div>
                </a>
            </div>
        </div>
    </template>

    <template id="portal_breadcrumbs_dosign" name="Portal breadcrumbs: signature documents"
              inherit_id="portal.portal_breadcrumbs" priority="45">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'dosign_documents'" class="breadcrumb-item active">
                Signature Documents
            </li>
        </xpath>
    </template>

    <template id="portal_my_dosign_documents" name="My Signature Documents">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Signature Documents</t>
            </t>
            <div t-if="not rows" class="alert alert-warning" role="alert">
                There are no signature documents.
            </div>
            <t t-if="rows" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Document</th>
                        <th class="d-none d-md-table-cell">Reference</th>
                        <th class="d-none d-md-table-cell">Date</th>
                        <th>Status</th>
                        <th class="text-end"/>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="rows" t-as="row">
                        <t t-set="document" t-value="row['document']"/>
                        <td class="align-middle">
                            <span t-field="document.name"/>
                            <div t-if="document.expiry_date and document.state in ('sent', 'partial')"
                                 class="small text-muted">
                                Expires on <span t-field="document.expiry_date"/>
                            </div>
                        </td>
                        <td class="align-middle d-none d-md-table-cell">
                            <span t-field="document.reference"/>
                        </td>
                        <td class="align-middle d-none d-md-table-cell">
                            <span t-field="document.create_date" t-options="{'widget': 'date'}"/>
                        </td>
                        <td class="align-middle">
                            <span t-attf-class="badge rounded-pill text-bg-#{row['badge']}"
                                  t-out="row['status']"/>
                        </td>
                        <td class="align-middle text-end text-nowrap">
                            <a t-if="row['sign_url']" t-att-href="row['sign_url']"
                               class="btn btn-sm btn-primary">
                                <i class="fa fa-pencil me-1" role="img" aria-label="Sign" title="Sign"/>Sign
                            </a>
                            <a t-if="row['download_url']" t-att-href="row['download_url']"
                               class="btn btn-sm btn-secondary">
                                <i class="fa fa-download me-1" role="img" aria-label="Download"
                                   title="Download"/>Download
                            </a>
                        </td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>
</odoo>
